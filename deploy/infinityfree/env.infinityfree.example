# Copy this file to "env.production" (same folder) and fill in the values
# from InfinityFree: Control Panel > MySQL Databases.
# build.sh will copy it as ".env" into the upload folder.

APP_NAME="MediCore"
APP_ENV=production
# Your InfinityFree address, with the final slash (use https once SSL is active)
APP_URL=https://your-site.infinityfreeapp.com/

DB_CONNECTION=mysqli
DB_HOST=sqlXXX.infinityfree.com
DB_PORT=3306
DB_DATABASE=if0_XXXXXXXX_hms
DB_USERNAME=if0_XXXXXXXX
DB_PASSWORD=your_vpanel_password

SESSION_DRIVER=files
SESSION_LIFETIME=7200
