APP_NAME="MediCore"
APP_ENV=local
CI_ENV=development
APP_KEY=
APP_DEBUG=true
# APP_URL is detected automatically (works in any htdocs folder). Set it only if needed.
# APP_URL=http://localhost/medicore/

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysqli
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=hms
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=files
SESSION_LIFETIME=7200

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

STRIPE_KEY=
STRIPE_SECRET_KEY=

PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox
# SESSION_SAVE_PATH defaults to application/cache/sessions (works on Windows and Mac).
# SESSION_SAVE_PATH=/tmp
